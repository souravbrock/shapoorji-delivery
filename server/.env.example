# Copy this file to .env on the server and fill in real values.
# In cPanel's "Setup Node.js App", you can also set these under
# the app's "Environment Variables" section instead of a .env file.

# --- MySQL (from cPanel -> MySQL Databases) ---
DB_HOST=localhost
DB_USER=reddevil_dbuser
DB_PASSWORD=changeme
DB_NAME=reddevil_shapoorji
DB_PORT=3306

# --- Auth ---
# Generate a long random string, e.g.: openssl rand -hex 32
JWT_SECRET=changeme-to-a-long-random-string
JWT_EXPIRES_IN=30d

# --- Server ---
PORT=3001
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=https://spdelivery.reddevils.co.in
# Public base URL of THIS API (used to build absolute image URLs).
# Only needed if reverse-proxying makes req.protocol/host unreliable.
# PUBLIC_API_URL=https://api.reddevils.co.in

# --- Email (use a cPanel email account you create, e.g. orders@reddevils.co.in) ---
SMTP_HOST=mail.reddevils.co.in
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=orders@reddevils.co.in
SMTP_PASSWORD=changeme
SMTP_FROM="Shapoorji Delivery <orders@reddevils.co.in>"
# Where new-order notifications get sent to (your own inbox)
ADMIN_NOTIFY_EMAIL=orders@reddevils.co.in
